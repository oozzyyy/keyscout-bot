# Токен от @BotFather
BOT_TOKEN=

# Адрес Python-сервиса (в docker-compose подставляется автоматически)
ANALYZER_URL=http://localhost:8000
# Как часто делать автопоиск (1h, 30m, 2m для теста)
AUTO_INTERVAL=1h

# Почта для отправки отчётов (пример для Яндекса: smtp.yandex.ru, 465, пароль приложения)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Веб-приложение (Telegram Mini App). Публичный HTTPS-адрес — для кнопки «Обзор» в боте.
# Для разработки не нужен: ./run.sh --tunnel поднимет туннель и подставит адрес сам.
WEBAPP_URL=
# Где бот слушает веб-приложение (по умолчанию 127.0.0.1:8080; off — выключить)
WEBAPP_ADDR=

# Если DNS сервера отдаёт заблокированный адрес Telegram (бывает на серверах в России),
# бот будет подключаться к api.telegram.org по этому IP, например 149.154.167.220
TELEGRAM_API_IP=

# Если Telegram не открывается без VPN: http://host:port или socks5://host:port
TELEGRAM_PROXY=

# Ключ Claude API — для автоподбора вариантов слов (клод → claude, anthropic…). Модель по умолчанию: claude-haiku-5-5
# Взять: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Кому доступна команда /export (журнал поисков в Excel): ID в Telegram через запятую.
# Свой ID бот пришлёт по команде /id. ID постоянный, а ник можно сменить — поэтому лучше ID.
ADMIN_IDS=
# Старый способ — ники без @ через запятую; используется, только если ADMIN_IDS пуст
ADMIN_USERNAMES=

# DeepSeek вместо Claude — работает и с серверов в России (Anthropic оттуда запросы не принимает).
# Ключ: https://platform.deepseek.com/api_keys. Модель по умолчанию — deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Если заданы оба ключа, по умолчанию используется Claude; LLM_PROVIDER=deepseek — выбрать DeepSeek
LLM_PROVIDER=

# Модели Claude (нужен ANTHROPIC_API_KEY): подбор вариантов слов и аналитическая выжимка.
# Можно поставить claude-sonnet-5-5 — подробнее, но дороже.
CLAUDE_MODEL=claude-haiku-5-5
DIGEST_MODEL=claude-haiku-5-5
